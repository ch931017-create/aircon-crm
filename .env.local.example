# =========================================================
# Supabase (필수)
# Project Settings → API 에서 복사
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 서비스 롤 키 (현재 코드에서 직접 사용하지는 않지만, 추후 server-only 작업에
# 대비해 남겨둠. Vercel에 등록 시에는 Sensitive로 설정. 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# =========================================================
# 앱 공개 URL (필수: 해피콜 SMS 링크 생성에 사용)
# 로컬: http://localhost:3000
# 프리뷰/프로덕션: https://YOUR-DOMAIN  (Vercel에서 자동 부여되는 URL 또는 커스텀 도메인)
# 끝에 슬래시(/) 붙이지 말 것
# =========================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================================
# SOLAPI 문자 발송 (해피콜 SMS 사용 시 필수)
# https://solapi.com 콘솔에서 발급
# 미설정 시 SMS 발송은 실패하지만 콜 완료 처리 자체는 정상 동작
# =========================================================
SOLAPI_API_KEY=YOUR-SOLAPI-KEY
SOLAPI_API_SECRET=YOUR-SOLAPI-SECRET
SOLAPI_SENDER=발신번호
